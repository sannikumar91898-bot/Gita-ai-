"use client";

import { useState } from "react";
import Link from "next/link";

const categories = [
  { value: "login", label: "Login problem" },
  { value: "registration", label: "Registration problem" },
  { value: "chat", label: "AI chat is not replying" },
  { value: "kundli", label: "Kundli or birth details" },
  { value: "payment", label: "Payment or subscription" },
  { value: "bug", label: "App error or bug" },
  { value: "feedback", label: "Suggestion or feedback" },
  { value: "other", label: "Other issue" },
];

export default function SupportPage() {
  const [category, setCategory] = useState("chat");
  const [subject, setSubject] = useState("");
  const [message, setMessage] = useState("");
  const [email, setEmail] = useState("");
  const [website, setWebsite] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  async function submit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setBusy(true);
    setError("");
    setSuccess("");

    try {
      const response = await fetch("/api/support", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        cache: "no-store",
        body: JSON.stringify({
          category,
          subject,
          message,
          email,
          website,
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || "Unable to submit your request.");
      }

      setSuccess(
        `${data.message} Reference: ${data.ticketId}`,
      );
      setSubject("");
      setMessage("");
      setWebsite("");
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Something went wrong. Please try again.",
      );
    } finally {
      setBusy(false);
    }
  }

  return (
    <main className="min-h-screen bg-[#100D20] px-4 py-8 text-white">
      <section className="mx-auto max-w-xl rounded-3xl border border-amber-300/20 bg-[#1B1730] p-6 shadow-2xl sm:p-8">
        <Link
          href="/"
          className="text-sm text-amber-200 hover:text-amber-100"
        >
          ← Back to Gita AI
        </Link>

        <div className="mt-6">
          <div className="text-3xl">💬</div>
          <h1 className="mt-3 text-2xl font-semibold">
            Gita AI Support
          </h1>
          <p className="mt-2 text-sm leading-6 text-violet-200">
            Tell us what went wrong or share an idea to improve Gita AI.
            Our support team can use your report to investigate the issue.
          </p>
        </div>

        <form onSubmit={submit} className="mt-7 space-y-5">
          <label className="block text-sm text-violet-100">
            Issue category
            <select
              value={category}
              onChange={(e) => setCategory(e.target.value)}
              className="mt-2 w-full rounded-xl border border-violet-300/20 bg-[#100D20] px-4 py-3 text-white"
            >
              {categories.map((item) => (
                <option key={item.value} value={item.value}>
                  {item.label}
                </option>
              ))}
            </select>
          </label>

          <label className="block text-sm text-violet-100">
            Subject
            <input
              required
              minLength={3}
              maxLength={120}
              value={subject}
              onChange={(e) => setSubject(e.target.value)}
              placeholder="For example: Chat is stuck on loading"
              className="mt-2 w-full rounded-xl border border-violet-300/20 bg-[#100D20] px-4 py-3 text-white placeholder:text-violet-500"
            />
          </label>

          <label className="block text-sm text-violet-100">
            Email (optional)
            <input
              type="email"
              maxLength={254}
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              placeholder="Where support can contact you"
              className="mt-2 w-full rounded-xl border border-violet-300/20 bg-[#100D20] px-4 py-3 text-white placeholder:text-violet-500"
            />
          </label>

          <label className="block text-sm text-violet-100">
            Describe the problem
            <textarea
              required
              minLength={10}
              maxLength={4000}
              rows={6}
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              placeholder="What happened? What did you expect to happen?"
              className="mt-2 w-full resize-y rounded-xl border border-violet-300/20 bg-[#100D20] px-4 py-3 text-white placeholder:text-violet-500"
            />
          </label>

          <div
            aria-hidden="true"
            className="absolute -left-[10000px] h-px w-px overflow-hidden"
          >
            <label>
              Leave this field empty
              <input
                tabIndex={-1}
                autoComplete="off"
                value={website}
                onChange={(e) => setWebsite(e.target.value)}
              />
            </label>
          </div>

          {error && (
            <p
              role="alert"
              className="rounded-xl border border-red-400/30 bg-red-950/40 p-3 text-sm text-red-200"
            >
              {error}
            </p>
          )}

          {success && (
            <p
              role="status"
              className="break-words rounded-xl border border-green-400/30 bg-green-950/30 p-3 text-sm text-green-200"
            >
              {success}
            </p>
          )}

          <button
            type="submit"
            disabled={busy}
            className="w-full rounded-xl bg-gradient-to-r from-amber-200 to-yellow-500 px-4 py-3 font-semibold text-[#20172C] disabled:opacity-60"
          >
            {busy ? "Sending…" : "Send to Support"}
          </button>

          <p className="text-xs leading-5 text-violet-300">
            Please do not include passwords, OTPs, payment PINs, API keys,
            or other sensitive information in your report.
          </p>
        </form>
      </section>
    </main>
  );
}