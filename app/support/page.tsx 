"use client";

import { useState } from "react";
import Link from "next/link";
import { ArrowLeft, MessageSquare } from "lucide-react";
import { useApp } from "../Providers"; // 🔥 Theme aur Language ke liye import kiya

export default function SupportPage() {
  const { lang, theme } = useApp(); // 🔥 useApp hook use kiya
  
  const isDark = theme === "dark";
  const isHindi = lang === "hi";
  const isHinglish = lang === "hinglish";

  const t = (hi: string, hing: string, en: string) =>
    isHindi ? hi : isHinglish ? hing : en;

  // Categories with translation
  const categories = [
    { value: "login", label: t("लॉगिन समस्या", "Login problem", "Login problem") },
    { value: "registration", label: t("रजिस्ट्रेशन समस्या", "Registration problem", "Registration problem") },
    { value: "chat", label: t("AI चैट जवाब नहीं दे रही", "AI chat is not replying", "AI chat is not replying") },
    { value: "kundli", label: t("कुंडली या जन्म विवरण", "Kundli or birth details", "Kundli or birth details") },
    { value: "payment", label: t("भुगतान या सदस्यता", "Payment or subscription", "Payment or subscription") },
    { value: "bug", label: t("ऐप त्रुटि या बग", "App error or bug", "App error or bug") },
    { value: "feedback", label: t("सुझाव या फीडबैक", "Suggestion or feedback", "Suggestion or feedback") },
    { value: "other", label: t("अन्य समस्या", "Other issue", "Other issue") },
  ];

  const [category, setCategory] = useState("chat");
  const [subject, setSubject] = useState("");
  const [message, setMessage] = useState("");
  const [email, setEmail] = useState("");
  const [website, setWebsite] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  async function submit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setBusy(true);
    setError("");
    setSuccess("");

    try {
      const response = await fetch("/api/support", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        cache: "no-store",
        body: JSON.stringify({
          category,
          subject,
          message,
          email,
          website,
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || "Unable to submit your request.");
      }

      setSuccess(`${data.message} Reference: ${data.ticketId}`);
      setSubject("");
      setMessage("");
      setWebsite("");
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Something went wrong. Please try again."
      );
    } finally {
      setBusy(false);
    }
  }

  // Theme classes
  const pageClass = isDark ? "bg-[#100D20] text-white" : "bg-[#FEF8EF] text-slate-900";
  const cardClass = isDark ? "border-amber-300/20 bg-[#1B1730]" : "border-orange-200 bg-white shadow-xl";
  const inputClass = isDark 
    ? "mt-2 w-full rounded-xl border border-violet-300/20 bg-[#100D20] px-4 py-3 text-white placeholder:text-violet-500 focus:border-amber-300 focus:outline-none"
    : "mt-2 w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-orange-500 focus:outline-none";

  return (
    <main className={`min-h-screen px-4 py-8 ${pageClass}`}>
      <section className={`mx-auto max-w-xl rounded-3xl border p-6 shadow-2xl sm:p-8 ${cardClass}`}>
        
        {/* Header Navigation */}
        <div className="flex items-center gap-3">
          <Link
            href="/settings"
            className={`rounded-xl p-2 ${isDark ? "bg-slate-800 text-amber-200" : "bg-orange-50 text-orange-600"}`}
          >
            <ArrowLeft size={18} />
          </Link>
          <span className={`text-sm font-semibold ${isDark ? "text-amber-200" : "text-orange-600"}`}>
            {t("सेटिंग्स पर वापस जाएं", "Back to Settings", "Back to Settings")}
          </span>
        </div>

        {/* Title Section */}
        <div className="mt-6">
          <div className={`flex h-12 w-12 items-center justify-center rounded-2xl ${isDark ? "bg-amber-300/10 text-amber-300" : "bg-orange-100 text-orange-600"}`}>
            <MessageSquare size={24} />
          </div>
          <h1 className="mt-3 text-2xl font-bold">
            {t("गीता AI सपोर्ट", "Gita AI Support", "Gita AI Support")}
          </h1>
          <p className={`mt-2 text-sm leading-6 ${isDark ? "text-violet-200" : "text-gray-600"}`}>
            {t(
              "हमें बताएं कि क्या गलत हुआ या गीता AI को बेहतर बनाने के लिए सुझाव दें। हमारी टीम आपकी रिपोर्ट की जांच करेगी।",
              "Humein batayein ki kya galat hua ya Gita AI ko behtar banane ke liye sujhaav dein. Hamari team aapki report ki jaanch karegi.",
              "Tell us what went wrong or share an idea to improve Gita AI. Our support team will investigate the issue."
            )}
          </p>
        </div>

        {/* Form */}
        <form onSubmit={submit} className="mt-7 space-y-5">
          <label className={`block text-sm font-medium ${isDark ? "text-violet-100" : "text-gray-700"}`}>
            {t("समस्या की श्रेणी", "Issue category", "Issue category")}
            <select
              value={category}
              onChange={(e) => setCategory(e.target.value)}
              className={inputClass}
            >
              {categories.map((item) => (
                <option key={item.value} value={item.value}>
                  {item.label}
                </option>
              ))}
            </select>
          </label>

          <label className={`block text-sm font-medium ${isDark ? "text-violet-100" : "text-gray-700"}`}>
            {t("विषय", "Subject", "Subject")}
            <input
              required
              minLength={3}
              maxLength={120}
              value={subject}
              onChange={(e) => setSubject(e.target.value)}
              placeholder={t("उदाहरण: चैट लोडिंग पर अटकी है", "For example: Chat is stuck on loading", "For example: Chat is stuck on loading")}
              className={inputClass}
            />
          </label>

          <label className={`block text-sm font-medium ${isDark ? "text-violet-100" : "text-gray-700"}`}>
            {t("ईमेल (वैकल्पिक)", "Email (optional)", "Email (optional)")}
            <input
              type="email"
              maxLength={254}
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              placeholder={t("जहाँ सपोर्ट आपसे संपर्क कर सके", "Where support can contact you", "Where support can contact you")}
              className={inputClass}
            />
          </label>

          <label className={`block text-sm font-medium ${isDark ? "text-violet-100" : "text-gray-700"}`}>
            {t("समस्या का विवरण दें", "Describe the problem", "Describe the problem")}
            <textarea
              required
              minLength={10}
              maxLength={4000}
              rows={5}
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              placeholder={t(
                "क्या हुआ? आप क्या उम्मीद कर रहे थे?",
                "Kya hua? Aap kya umeed kar rahe the?",
                "What happened? What did you expect to happen?"
              )}
              className={`${inputClass} resize-none`}
            />
          </label>

          {/* Honeypot field for bots */}
          <div aria-hidden="true" className="absolute -left-[10000px] h-px w-px overflow-hidden">
            <label>
              Leave this field empty
              <input
                tabIndex={-1}
                autoComplete="off"
                value={website}
                onChange={(e) => setWebsite(e.target.value)}
              />
            </label>
          </div>

          {error && (
            <p role="alert" className="rounded-xl border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-500">
              {error}
            </p>
          )}

          {success && (
            <p role="status" className="break-words rounded-xl border border-green-400/30 bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400">
              {success}
            </p>
          )}

          <button
            type="submit"
            disabled={busy}
            className={`w-full rounded-xl px-4 py-3 font-semibold transition-all ${
              isDark
                ? "bg-gradient-to-r from-amber-200 to-yellow-500 text-[#20172C] hover:opacity-90 disabled:opacity-60"
                : "bg-orange-600 text-white hover:bg-orange-700 disabled:opacity-60"
            }`}
          >
            {busy
              ? t("भेजा जा रहा है...", "Sending...", "Sending...")
              : t("सपोर्ट को भेजें", "Send to Support", "Send to Support")}
          </button>

          <p className={`text-xs leading-5 ${isDark ? "text-violet-300" : "text-gray-500"}`}>
            {t(
              "कृपया अपनी रिपोर्ट में पासवर्ड, OTP, भुगतान पिन, API कुंजी या अन्य संवेदनशील जानकारी शामिल न करें।",
              "Kripya apni report mein password, OTP, payment PIN, API keys ya koi bhi sensitive info shamil na karein.",
              "Please do not include passwords, OTPs, payment PINs, API keys, or other sensitive information in your report."
            )}
          </p>
        </form>
      </section>
    </main>
  );
}