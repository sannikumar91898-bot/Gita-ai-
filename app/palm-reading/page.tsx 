      // 🔥 401: Unauthorized
      if (res.status === 401) {
        router.push("/login?redirect=/palm-reading");
        return;
      }

      // 🔥 402: Wallet Recharge Required (Free limit exhausted)
      if (res.status === 402 || data.code === "WALLET_RECHARGE_REQUIRED") {
        router.push("/wallet?reason=palm_limit");
        return;
      }

